{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "csrf-backend-c",
  "compatibility_date": "2024-12-01",
  "main": "src/index.ts",
  "vars": {
    "EXPECTED_ORIGIN": "https://csrf-frontend-different-domain.surge.sh",
    "COOKIE_SAMESITE": "None",
    "COOKIE_NAME": "csrf_demo",
    "COOKIE_VALUE": "backend-c",
    "BACKEND_ID": "C"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "csrf-demo-logs",
      "database_id": "bdf9bd82-b20f-4863-997d-08a61c11003b"
    }
  ]
}
